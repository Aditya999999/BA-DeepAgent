# -----------------------------------------------------------------------------
# Application / server
# -----------------------------------------------------------------------------
APP_NAME=forgex-ba-api
APP_VERSION=0.1.0
ENVIRONMENT=development                            # development
DEBUG=true                                          # true|false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                                      # DEBUG|INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# MongoDB (REQUIRED) - chat history, session
# -----------------------------------------------------------------------------
MONGODB_DATABASE_URI=mongodb+srv://admin:Urp
BA_DB_NAME=ba_db
MONGODB_WORKFLOW_DATABASE_NAME=npd_workflow_

# Collections (QE_CHAT_COLLECTION and QE_SES
# session managers - they raise if unset).
BA_CHAT_COLLECTION=ba_chat_history
BA_SESSION_CONTEXT=ba_session_context
BA_USER_CONFIG_COLLECTION=ba_user_config

# Connection pool tuning (optional)
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=5
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Workflow / QE persistence collections
# -----------------------------------------------------------------------------
WORKFLOW_COLLECTION_NAME=workflow_jobs
WORKFLOW_ARTIFACT_COLLECTION_NAME=workflow_art
WORKFLOW_CONFIG_COLLECTION_NAME=workflow_confi
BA_BRD_COLLECTION=ba_brd_snapshots


# Which model to use (anthropic/openai)
MODEL_USAGE=openai
# -----------------------------------------------------------------------------
# Anthropic / Claude via Azure Foundry (REQUI
# -----------------------------------------------------------------------------
ANTHROPIC_FOUNDRY_API_KEY=8sDgg5d09PUhhBeviwre
ANTHROPIC_FOUNDRY_BASE_URL=https://forgex-mode
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4


# -----------------------------------------------------------------------------
# OpenAI / GPT via Azure Foundry (REQUIRED for
# -----------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=DFS33r4EydQf9YSX896bxfWeHbM
AZURE_OPENAI_BASE_URL=https://openai-hbu.opena
AZURE_OPENAI_MODEL=gpt-5.6-luna-FE

AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Reasoning-family deployments (gpt-5.x) only ac
AZURE_OPENAI_TEMPERATURE=1.0
AZURE_OPENAI_MAX_TOKENS=8192

BA_MAX_TOKENS=16000
# Force the legacy non-streaming AzureClaudeCha
# streaming ChatAnthropic model required for SSE
